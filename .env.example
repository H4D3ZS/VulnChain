# VulnChain Environment Configuration

# Application
APP_NAME=VulnChain
APP_VERSION=0.1.0
DEBUG=false

# Database
POSTGRES_USER=vulnchain
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=vulnchain
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-in-production
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production-use-long-random-string
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_EXPIRATION_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Celery Flower
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# OOB Listener
OOB_HTTP_PORT=8080
OOB_DNS_PORT=53
OOB_DOMAIN=oob.vulnchain.local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
