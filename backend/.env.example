# Application
APP_NAME=VulnChain
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://vulnchain:vulnchain@localhost:5432/vulnchain
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# OOB Listener
OOB_HTTP_PORT=8080
OOB_DNS_PORT=53
OOB_DOMAIN=oob.vulnchain.local

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# External Tools
WHATWEB_PATH=/usr/bin/whatweb
WPSCAN_PATH=/usr/bin/wpscan
SQLMAP_PATH=/usr/bin/sqlmap

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
