# Example secrets file - DO NOT commit actual secrets to version control
# Create actual secrets using: kubectl create secret generic vulnchain-secrets --from-literal=...

apiVersion: v1
kind: Secret
metadata:
  name: vulnchain-secrets
  namespace: vulnchain
type: Opaque
stringData:
  # Database
  POSTGRES_PASSWORD: "change-me-in-production"
  DATABASE_URL: "postgresql+asyncpg://vulnchain:change-me-in-production@postgres:5432/vulnchain"
  
  # Redis
  REDIS_PASSWORD: "change-me-in-production"
  
  # Application
  SECRET_KEY: "change-me-in-production-use-long-random-string"
  JWT_SECRET_KEY: "change-me-in-production-use-long-random-string"
  
  # Flower
  FLOWER_USER: "admin"
  FLOWER_PASSWORD: "change-me-in-production"
